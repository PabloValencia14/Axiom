<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="google_sync_prefs.xml"/>
        <exclude domain="sharedpref" path="zlibrary_prefs.xml"/>
        <exclude domain="sharedpref" path="opds_catalog_prefs.xml"/>
        <exclude domain="sharedpref" path="openreadera_openrouter_secrets.xml"/>
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="google_sync_prefs.xml"/>
        <exclude domain="sharedpref" path="zlibrary_prefs.xml"/>
        <exclude domain="sharedpref" path="opds_catalog_prefs.xml"/>
        <exclude domain="sharedpref" path="openreadera_openrouter_secrets.xml"/>
    </device-transfer>
</data-extraction-rules>
